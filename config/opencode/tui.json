{
  "$schema": "https://opencode.ai/tui.json",
  "keybinds": {
    "command_list": "<leader>p",
    "dialog.select.home": "home,alt+shift+,",
    "dialog.select.end": "end,alt+shift+.",
    "messages_first": "alt+shift+,",
    "model_provider_list": "none",
    "variant_cycle": "none",
